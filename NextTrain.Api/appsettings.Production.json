{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    // One line per entry: each line is a billed Log Analytics row, and a stack trace was 40 or more of them.
    "Console": {
      "FormatterOptions": { "SingleLine": true }
    }
  }
}
